{
  "name": "@g-1/test",
  "version": "3.5.15",
  "description": "G1 Test Suite. The unified, high-rigor test framework and suite for all G1 services. Guarantees code integrity and compliance across all products.",
  "type": "module",
  "author": "G1 <dev@golive.me>",
  "license": "MIT",
  "homepage": "https://github.com/g-1-repo/devtools/tree/main/packages/test#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g-1-repo/devtools.git",
    "directory": "packages/test"
  },
  "bugs": {
    "url": "https://github.com/g-1-repo/devtools/issues"
  },
  "keywords": [
    "testing",
    "test-framework",
    "cloudflare-workers",
    "hono",
    "typescript",
    "cookies",
    "session-management"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "g1-test-suite": "./dist/test-runner.cjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli/test-runner.js",
      "types": "./dist/cli/test-runner.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "bunx @biomejs/biome@^2.3.0 check src/",
    "lint:fix": "bunx @biomejs/biome@^2.3.0 check --write src/",
    "format": "bunx @biomejs/biome@^2.3.0 format --write src/",
    "test": "vitest --no-watch",
    "test:watch": "vitest",
    "test:coverage": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit",
    "test-runner": "bun run src/cli/test-runner.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@faker-js/faker": "^10.1.0",
    "@g-1/util": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "chalk": "^5.6.2",
    "cosmiconfig": "^9.0.0",
    "enquirer": "^2.4.1",
    "execa": "^9.6.0",
    "glob": "^11.0.3",
    "listr2": "^9.0.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@g-1/workflow": "^3.5.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.8.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.44.6",
    "hono": "^4.10.1",
    "vitest": "^3.2.4"
  }
}