{
  "name": "@g-1/workflow",
  "version": "3.13.0",
  "description": "G1 Enterprise Workflow System. Badass, production-ready release automation that serves as the backbone for major development organizations. Features intelligent error recovery, beautiful UI, and enterprise-scale reliability.",
  "license": "MIT",
  "homepage": "https://github.com/g-1-repo/devtools/tree/main/packages/workflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g-1-repo/devtools.git",
    "directory": "packages/workflow"
  },
  "bugs": {
    "url": "https://github.com/g-1-repo/devtools/issues"
  },
  "keywords": [
    "workflow",
    "release",
    "automation",
    "ci-cd",
    "git",
    "npm",
    "github",
    "enterprise",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli.esm.js",
      "require": "./dist/cli.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "bin": {
    "workflow": "dist/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "bunx @biomejs/biome@^2.3.0 check src/",
    "lint:fix": "bunx @biomejs/biome@^2.3.0 check --write src/",
    "format": "bunx @biomejs/biome@^2.3.0 format --write src/",
    "test": "vitest --no-watch",
    "test:watch": "vitest",
    "test:coverage": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit",
    "release": "node dist/cli.js release"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@g-1/ai-core": "^1.0.0",
    "@g-1/util": "^2.0.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "conventional-commits-parser": "^6.2.1",
    "cosmiconfig": "^9.0.0",
    "execa": "^9.6.0",
    "glob": "^11.0.3",
    "ora": "^9.0.0",
    "semver": "^7.7.3",
    "simple-git": "^3.28.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^24.9.1",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}