{
  "name": "complex-monorepo-fixture",
  "version": "3.5.15",
  "private": true,
  "description": "Complex monorepo fixture with circular dependencies for testing",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A run build",
    "test": "yarn workspaces foreach -A run test",
    "lint": "yarn workspaces foreach -A run lint",
    "clean": "yarn workspaces foreach -A run clean",
    "dev": "concurrently \"yarn workspace @fixture/web dev\" \"yarn workspace @fixture/api dev\"",
    "typecheck": "yarn workspaces foreach -A run typecheck"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "typescript": "^4.9.0",
    "eslint": "^8.0.0",
    "prettier": "^2.8.0",
    "concurrently": "^7.6.0"
  },
  "packageManager": "yarn@3.6.0"
}
